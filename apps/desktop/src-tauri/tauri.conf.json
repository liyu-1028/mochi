{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mochi",
  "version": "0.2.0",
  "identifier": "app.mochi.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../scripts/download-live2d-core.mjs && bash ../../scripts/package-sidecar.sh && pnpm --filter @mochi/desktop exec tsc --noEmit && pnpm --filter @mochi/desktop exec vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "character",
        "title": "Mochi",
        "width": 320,
        "height": 400,
        "minWidth": 320,
        "maxWidth": 320,
        "minHeight": 400,
        "maxHeight": 400,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "shadow": false,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/sidecar/": "sidecar/"
    },
    "macOS": {
      "minimumSystemVersion": "12",
      "signingIdentity": null
    }
  }
}
