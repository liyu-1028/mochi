# Dependencies
node_modules/
.venv/

# Build outputs
dist/
target/
*.egg-info/
# PyInstaller 构建工作目录（gitignore 不支持行尾注释，必须单独一行）
server/build/

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Env & secrets（规范：Key 永不入库，见 docs/specs/config-format.md）
.env
.env.*

# OS / editor / 工具本地配置
.claude/
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Logs
*.log
logs/

# Live2D Cubism Core（专有代码，脚本下载，见 scripts/download-live2d-core.mjs）
apps/desktop/public/live2d/

# sidecar 生产二进制（PyInstaller 构建后落位，Tauri externalBin 读取；见 scripts/package-sidecar.sh）
apps/desktop/src-tauri/binaries/

# 内部过程文档（调研、决策推演、测试报告等，不入库）
docs/internal/
docs/test-reports/

# 本地舞蹈评估资源：按固定来源下载，开发服务器专用，不进产品包
assets/prototypes/vrm-dance/*.vrm
assets/prototypes/vrm-dance/*.fbx

# 内置 VRM 角色模型：postinstall 经 scripts/download-vrm-assets.mjs 下载
assets/skins/mochi-vrm/model.vrm
assets/skins/seed-san/model.vrm

# VRoid 官方动作包：许可不允许分发可提取的原版/改版，仅本地导入
assets/VRMA_MotionPack.zip
assets/VRMA_MotionPack/vrma/
assets/local-motions/

# 录屏原始素材（体积大，仅本地留存，见 docs/images/demo1.gif）
docs/images/*.mov

# 用户下载的原始动作素材和本地聊天导出，不随源码公开
assets/愛包ダンスホール/
assets/愛包ダンスホール.zip
assets/VRMA_MotionPack/Readme*.txt
server/*-local-command-*.txt
